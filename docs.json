{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Protoface",
  "description": "Call frontier media models and live avatars through one API.",
  "colors": {
    "primary": "#0c0d0e",
    "light": "#fcfbfa",
    "dark": "#0c0d0e"
  },
  "appearance": {
    "default": "light",
    "strict": false
  },
  "logo": {
    "light": "/images/brand/protoface-logo-light.png",
    "dark": "/images/brand/protoface-logo-dark.png",
    "href": "https://protoface.com"
  },
  "favicon": {
    "light": "/images/brand/protoface-mark-ink.png",
    "dark": "/images/brand/protoface-mark-white.png"
  },
  "icons": {
    "library": "lucide"
  },
  "contextual": {
    "display": "header",
    "options": [
      "copy",
      "chatgpt",
      "claude",
      "cursor",
      "vscode",
      "download-spec"
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "https://protoface.discourse.group"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.protoface.com"
    }
  },
  "api": {
    "openapi": "openapi.json",
    "playground": {
      "display": "none"
    },
    "url": "full",
    "examples": {
      "languages": ["curl", "python", "javascript"],
      "defaults": "required",
      "prefill": true,
      "autogenerate": true
    }
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Main Site",
          "icon": "globe",
          "href": "https://protoface.com"
        },
        {
          "anchor": "Dashboard",
          "icon": "layout-dashboard",
          "href": "https://app.protoface.com"
        },
        {
          "anchor": "Examples",
          "icon": "github",
          "href": "https://github.com/protoface-ai/protoface-quickstart"
        },
        {
          "anchor": "Support",
          "icon": "life-buoy",
          "href": "https://protoface.discourse.group/"
        },
        {
          "anchor": "Status",
          "icon": "activity",
          "href": "https://status.protoface.com"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Docs",
        "icon": "book-open",
        "pages": [
          "index",
          {
            "group": "Inference",
            "pages": [
              "guides/model-inference",
              {
                "group": "Examples",
                "expanded": true,
                "pages": [
                  "guides/generate-video",
                  "guides/generate-image",
                  "guides/image-to-video"
                ]
              },
              "guides/runs",
              "guides/models",
              "guides/assets"
            ]
          },
          {
            "group": "Realtime",
            "pages": [
              "quickstart",
              {
                "group": "Avatars",
                "expanded": true,
                "pages": [
                  "guides/avatars",
                  "guides/avatar-source-images"
                ]
              },
              "guides/embeds",
              {
                "group": "Integrations",
                "expanded": true,
                "pages": [
                  "guides/livekit-agents",
                  "guides/pipecat",
                  "guides/more-integrations"
                ]
              }
            ]
          },
          {
            "group": "Account",
            "pages": [
              "reference/quotas",
              "guides/usage"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "guides/authentication",
              "reference/errors"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "icon": "square-terminal",
        "openapi": "openapi.json",
        "pages": [
          "api-reference/index",
          {
            "group": "Model inference",
            "pages": [
              "GET /v1/models",
              "GET /v1/models/{model_id}",
              "POST /v1/run/{model_id}",
              "GET /v1/runs",
              "GET /v1/runs/{run_id}",
              "GET /v1/runs/{run_id}/status",
              "GET /v1/runs/{run_id}/events",
              "POST /v1/runs/{run_id}/cancel"
            ]
          },
          {
            "group": "Assets",
            "pages": [
              "POST /v1/assets",
              "GET /v1/assets",
              "GET /v1/assets/{asset_id}",
              "GET /v1/assets/{asset_id}/content",
              "DELETE /v1/assets/{asset_id}"
            ]
          },
          {
            "group": "Avatars",
            "pages": [
              "GET /v1/avatars",
              "POST /v1/avatars",
              "GET /v1/avatars/{avatar_id}",
              "DELETE /v1/avatars/{avatar_id}"
            ]
          },
          {
            "group": "Realtime sessions",
            "pages": [
              "POST /v1/pipecat/sessions",
              "GET /v1/sessions",
              "POST /v1/sessions",
              "GET /v1/sessions/{session_id}",
              "POST /v1/sessions/{session_id}/end"
            ]
          },
          {
            "group": "Account and platform",
            "pages": [
              "GET /v1/billing/plans",
              "GET /v1/billing/quota",
              "GET /v1/usage",
              "GET /v1/status"
            ]
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/guides/what-you-can-generate",
      "destination": "/guides/models"
    },
    {
      "source": "/guides/sessions",
      "destination": "/guides/livekit-agents"
    },
    {
      "source": "/concepts/transports",
      "destination": "/guides/livekit-agents"
    },
    {
      "source": "/concepts/architecture",
      "destination": "/"
    },
    {
      "source": "/guides/libraries",
      "destination": "/guides/more-integrations"
    },
    {
      "source": "/guides/video-generation",
      "destination": "/guides/model-inference"
    },
    {
      "source": "/guides/videos",
      "destination": "/guides/model-inference"
    },
    {
      "source": "/api-reference/videos/generate-a-video",
      "destination": "/guides/model-inference"
    },
    {
      "source": "/reference/limits",
      "destination": "/reference/quotas"
    },
    {
      "source": "/reference/known-limitations",
      "destination": "/reference/errors"
    },
    {
      "source": "/reference/known-issues",
      "destination": "/reference/errors"
    },
    {
      "source": "/guides/agents",
      "destination": "/"
    }
  ]
}
